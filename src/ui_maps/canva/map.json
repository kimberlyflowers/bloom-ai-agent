  "common_workflows": {
    "create_instagram_post": {
      "steps": [
        "Click create button (purple + in left sidebar)",
        "Type 'Instagram Post' in search or select Social Media category",
        "Click Instagram Post option (1080x1080)",
        "Wait for editor to load"
      ],
      "estimated_time": "2-3 seconds with UI map",
      "interaction_types": ["modal", "inline", "navigation"]
    },
    "export_design": {
      "steps": [
        "In editor, click Share or Download button (top right)",
        "Wait for right sidebar to open (no page navigation)",
        "Select file type (PNG, JPG, PDF, etc)",
        "Adjust quality settings if needed",
        "Click Download button"
      ],
      "estimated_time": "3-5 seconds with UI map",
      "interaction_types": ["sidebar", "inline"],
      "note": "No page navigation - sidebar overlay only"
    },
    "resize_design": {
      "steps": [
        "In editor, click Resize button (top toolbar)",
        "Wait for right sidebar to open (no page navigation)",
        "Select new dimensions or enter custom size",
        "Click 'Copy & resize' or 'Resize this design'"
      ],
      "estimated_time": "2-4 seconds with UI map",
      "interaction_types": ["sidebar", "inline"],
      "note": "No page navigation - sidebar overlay only"
    },
    "access_brand_kit": {
      "steps": [
        "Click Brand icon (smiley face, left sidebar)",
        "Wait for Brand Kit page to load",
        "View brand assets (logos, colors, fonts)"
      ],
      "estimated_time": "2-3 seconds with UI map",
      "interaction_types": ["navigation"]
    },
    "learn_from_design_school": {
      "steps": [
        "Click Design School from left sidebar or navigation",
        "Search for topic or browse tabs",
        "Click course card to start learning",
        "Follow video or article tutorial"
      ],
      "estimated_time": "5-8 seconds to find content",
      "interaction_types": ["navigation", "inline"]
    }
  },

  "visual_patterns": {
    "purple_theme": "Canva's primary brand color (#7D2AE8 or similar) used for main CTAs and active states",
    "left_sidebar_navigation": "Always present vertical navigation with icon+text or icon-only",
    "editor_three_panel": "Left panel (tools), center (canvas), right panel (properties/actions)",
    "modals_centered": "Create menu and major dialogs appear centered with backdrop",
    "sidebars_slide": "Right/left sidebars slide in without page reload - important for interaction_type detection",
    "icon_consistency": "Consistent iconography - home=house, templates=grid, brand=smiley, etc"
  },

  "speed_optimization": {
    "use_selectors_first": true,
    "fallback_to_vision": true,
    "estimated_speedup": "10-15x faster than pure vision",
    "interaction_type_awareness": "Critical - don't wait for navigation on sidebar/modal interactions"
  }
}
