# Railway WebSocket URL
# Replace with your actual Railway deployment URL
# Format: wss://your-app-name.railway.app (NO PORT NEEDED - Railway handles it!)
# Example: wss://bloom-ai-agent-production.up.railway.app
# Dashboard will connect to /chat and /screen paths on this URL
NEXT_PUBLIC_RAILWAY_WS_URL=wss://your-railway-url.railway.app
